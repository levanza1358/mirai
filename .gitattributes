# Always check out shell launchers with executable permission (Linux/macOS).
# Without this, `./mirai start` fails with "Permission denied" after a fresh clone.
mirai text eol=lf executable
install.sh text eol=lf executable
update.sh text eol=lf executable
start.sh text eol=lf
mirai.cmd text eol=crlf
update.cmd text eol=crlf

*.sh text eol=lf executable
